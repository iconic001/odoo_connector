
<odoo>
    <record id="view_quickbooks_invoice_preview_form" model="ir.ui.view">
        <field name="name">quickbooks.invoice.preview.form</field>
        <field name="model">quickbooks.invoice.preview</field>
        <field name="arch" type="xml">
            <form string="QuickBooks Invoice Preview">
                <group>
                    <field name="invoice_id"/>
                </group>

                <group>
                    <button name="action_preview"
                            type="object"
                            string="Fetch Invoice Preview"
                            class="btn-primary"/>
                </group>

                <separator string="Invoice Details"/>

                <group>
                    <field name="qb_doc_number"/>
                    <field name="qb_customer"/>
                    <field name="qb_date"/>
                    <field name="qb_due_date"/>
                </group>

                <group string="Amounts">
                    <field name="qb_subtotal"/>
                    <field name="qb_tax"/>
                    <field name="qb_total"/>
                    <field name="qb_balance"/>
                </group>

                <group string="Import Status">
                    <field name="qb_already_imported"/>
                    <field name="qb_existing_invoice"
                           invisible="not qb_already_imported"/>
                </group>

                <field name="preview_message"
                       invisible="not preview_message"/>

                <footer>
                    <button name="action_import_as_draft"
                            type="object"
                            string="Import as Draft"
                            class="btn-primary"
                            invisible="not qb_doc_number or qb_already_imported"/>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quickbooks_invoice_preview"
            model="ir.actions.act_window">
        <field name="name">Preview QuickBooks Invoice</field>
        <field name="res_model">quickbooks.invoice.preview</field>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_quickbooks_invoice_preview_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_quickbooks_invoice_preview"
              name="Preview Invoice"
              parent="menu_quickbooks_root"
              action="action_quickbooks_invoice_preview"
              sequence="20"
              groups="account.group_account_manager"/>
</odoo>


